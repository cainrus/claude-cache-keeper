{
  "modules": [
    "./gate.ts"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/cache-keeper.sh\" check",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/cache-keeper.sh\" record",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_ENTRYPOINT\" = sdk-cli ] || { sleep \"${CACHE_KEEPER_DELAY_SEC:-3000}\"; sh \"${CLAUDE_PLUGIN_ROOT}/bin/cache-keeper.sh\" wake; }",
            "asyncRewake": true,
            "timeout": 7200
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/cache-keeper.sh\" touch",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/cache-keeper.sh\" end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
